# ---------------------------------------------------------------------------
# Azure OpenAI (unified v1 surface: the plain OpenAI client with a custom base_url)
# ---------------------------------------------------------------------------
AZURE_OPENAI_BASE_URL=https://<your-resource>.openai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=<your-azure-openai-key>
# This is the DEPLOYMENT name from Azure AI Foundry, not the model name. They often
# differ, and a model asked to identify itself frequently answers wrongly - read the
# real mapping from Foundry -> Deployments.
AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>

# ---------------------------------------------------------------------------
# LangSmith tracing (optional: powers the trace view and LangGraph Studio)
# ---------------------------------------------------------------------------
LANGCHAIN_API_KEY=<your-langsmith-key>
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=financial-extraction
LANGSMITH_API_KEY=<your-langsmith-key>

# ---------------------------------------------------------------------------
# Azure Blob Storage: source PDFs in, generated files out
# ---------------------------------------------------------------------------
DOC_PARSER_BLOB_CONNECTION_STRING=<your-blob-connection-string>
DOC_PARSER_BLOB_CONTAINER_NAME=<your-container>
DOC_PARSER_BLOB_ACCOUNT_URL=https://<your-account>.blob.core.windows.net
BLOB_UPLOAD_PREFIX=financial-agent/uploads
BLOB_OUTPUT_PREFIX=financial-agent/outputs

# ---------------------------------------------------------------------------
# Evalueserve IDP document parser
# ---------------------------------------------------------------------------
IDP_BASE_URL=https://<your-doc-parser-host>/api/DocumentParser
IDP_PARSE_PATH=parseDocument
IDP_STATUS_PATH=getStatusCountByRequestId

# Payload fields. LocatorType/SubType/Id prefix the parser's output filename,
# e.g. 00_0_00_<source>.json
IDP_PRODUCT_CLIENT_ID=9
IDP_PRODUCT_PROJECT_ID=9999
IDP_LOCATOR_TYPE=00
IDP_LOCATOR_SUBTYPE=0
IDP_LOCATOR_ID=00
IDP_KEY=A
IDP_AIRA_REQUEST_ID=

# Blank omits IsAdvanceParsing from the payload entirely
IDP_ADVANCE_PARSING=

# Where submitted PDFs and parser output are kept inside the blob container
IDP_WORK_PREFIX=financial-agent/idp

IDP_REQUEST_TIMEOUT_SECONDS=120
IDP_POLL_TIMEOUT_SECONDS=300
IDP_POLL_INTERVAL_SECONDS=3

# ---------------------------------------------------------------------------
# Agent behaviour
# ---------------------------------------------------------------------------
AGENT_MAX_REPAIR_ROUNDS=6
RECONCILE_TOLERANCE=0.02

# ---------------------------------------------------------------------------
# How the documents you receive write figures and dates
# ---------------------------------------------------------------------------
# The analyst knows the source, so this is the source of truth. The agent still reads
# the document and will TELL YOU if it disagrees - e.g. a UK rent roll in a US batch.
#   US  1,234.56  MM/DD/YYYY      UK  1,234.56  DD/MM/YYYY
#   IN  1,23,456.78 DD/MM/YYYY    EU  1.234,56  DD/MM/YYYY
#   CH  1'234.56  DD/MM/YYYY      ISO 1,234.56  YYYY-MM-DD
#   AUTO  work it out from the document alone
DOCUMENT_LOCALE=US

# --- Access -----------------------------------------------------------------
# A shared code plus a typed name. This is identity, not authentication: anyone with
# the code can claim any name. It exists so an approval can be attributed to a person.
# See app/auth.py. Do not put client documents through a build secured only by this.
APP_ACCESS_CODE=demo
# Signs the session cookie. Unset generates one per process, so restarting signs
# everyone out; set it to keep sessions across restarts.
APP_SESSION_SECRET=
